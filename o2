#!/usr/bin/env bash

case "$1" in
  db)
    if docker ps --format '{{.Names}}' | grep -q '^postgres$'; then
      echo "✅ Postgres container already running"
    else
      docker rm -f postgres 2>/dev/null
      docker run -d --name postgres -e POSTGRES_USER=hesabu-test-user -e POSTGRES_PASSWORD=hesabu-test-password -p 5432:5432 postgis/postgis:16-3.4
      echo "⏳ Waiting for Postgres to be ready..."
      until docker exec postgres pg_isready -U hesabu-test-user -q; do sleep 1; done
      echo "✅ Postgres ready — creating databases..."
      docker exec postgres psql -U hesabu-test-user -tc "SELECT 1 FROM pg_database WHERE datname='hesabu-test-user'" | grep -q 1 \
        || docker exec postgres createdb -U hesabu-test-user hesabu-test-user
      docker exec postgres psql -U hesabu-test-user -tc "SELECT 1 FROM pg_database WHERE datname='scorpio_development'" | grep -q 1 \
        || docker exec postgres createdb -U hesabu-test-user scorpio_development
      echo "✅ Databases ready: hesabu-test-user, scorpio_development"
    fi
    if docker ps --format '{{.Names}}' | grep -q '^redis$'; then
      echo "✅ Redis container already running"
    else
      docker rm -f redis 2>/dev/null
      docker run -d --name redis -p 6379:6379 redis:7-alpine
      echo "✅ Redis started"
    fi
    ;;
  redis)
    if docker ps --format '{{.Names}}' | grep -q '^redis$'; then
      echo "✅ Redis container already running"
      exit 0
    fi
    docker rm -f redis
    docker run --name redis -p 6379:6379 redis:7-alpine
    ;;
  sql)
    psql postgres://hesabu-test-user:hesabu-test-password@localhost:5432/hesabu-test-user
    ;;
  worker)
    bundle exec sidekiq -q dhis2-safe -q default -c "${SIDEKIQ_CONCURRENCY:-2}"
    ;;
  *)
    echo "Usage: $0 {db|redis|sql|worker}"
    exit 1
    ;;
esac
